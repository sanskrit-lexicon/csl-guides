<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — do not load this file directly. scripts/launchd/install.sh renders
  __HOME__ to the real home, writes ~/Library/LaunchAgents/<label>.plist, and
  bootstraps it. Weekly Sunday 06:40 local: the sibling-dependent contract gates
  (atlas-viz, heritage-coverage, corpus-frequency, vedic-accent) can only run where
  the sibling clones exist, so this is the lane A4 asked for, not a CI job.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gasyoun.csl-guides-contracts.weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/state/csl-guides/run-contracts.sh</string>
  </array>

  <!-- launchd starts with no shell environment: without this, node/npm/git are
       not on PATH and every gate looks like an environment failure. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>

  <key>LowPriorityIO</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/csl-guides-contracts.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/csl-guides-contracts.log</string>
</dict>
</plist>
